generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                String  @id @default("singleton")
  dailyCount        Int     @default(10)
  premiumSlots      Int     @default(2)
  scheduleHour      Int     @default(9)
  bannedWords       String  @default("[]")
  maxConcurrentTask Int     @default(20)
  maxPublishPerHour Int     @default(30)
  minScoreForPublish Int    @default(70)
  autoDeleteRejected Boolean @default(true)
  complianceLevel   String  @default("strict")
  rejectedCount     Int     @default(0)
}

model Account {
  id        String   @id @default(cuid())
  name      String
  platform  String
  tone      String   @default("")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model PlatformConnection {
  id          String   @id @default(cuid())
  platform    String   @unique
  accountName String   @default("")
  connected   Boolean  @default(false)
  tokenMask   String   @default("")
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  keywords  String   @default("")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id             String   @id @default(cuid())
  accountId      String
  categoryId     String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status         String
  tier           String
  objective      String   @default("涨粉")
  contentFormat  String   @default("图文")
  copyTitle      String   @default("")
  copyBody       String   @default("")
  imagePrompt    String   @default("")
  imageUrl       String   @default("")
  videoScript    String   @default("")
  videoUrl       String   @default("")
  benchmarkTitle String   @default("")
  benchmarkBody  String   @default("")
  benchmarkUrl   String   @default("")
  /// 用户填写的对标链接（粘贴）
  benchmarkUserLink   String   @default("")
  /// 用户上传的对标截图（data URL，可能较长）
  benchmarkUserImage  String   @default("") @db.Text
  qualityLabel   String   @default("中")
  processMemo    String   @default("")
  scoreCompliance Int     @default(0)
  scoreQuality   Int      @default(0)
  scoreConvert   Int      @default(0)
  scoreTotal     Float    @default(0)
  adopted        Boolean  @default(false)
  archived       Boolean  @default(false)
  failReason     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// 手机号验证码登录（避免 Vercel 无服务器环境写本地 JSON 失败）
model AuthUser {
  id        String        @id @default(cuid())
  phone     String        @unique
  createdAt DateTime      @default(now())
  sessions  AuthSession[]
}

model AuthSmsCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([phone, createdAt])
}

model AuthSession {
  token     String   @id
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// 策略配置页「平台账号池」（替代 data/platform-accounts.json）
model PlatformLinkedAccount {
  id               String   @id @default(cuid())
  platform         String
  username         String
  passwordMask     String   @default("******")
  connected        Boolean  @default(true)
  lastTestStatus   String   @default("ok")
  lastTestAt       DateTime @default(now())

  @@unique([platform, username])
}

/// 每日爆款推荐库（策略配置页导入 / 运营维护）
model TrendingPick {
  id           String   @id @default(cuid())
  platform     String
  /// 与「随便生」内容赛道一致（对应 Category.name）
  category     String
  title        String
  contentBody  String   @db.Text
  tagsJson     String   @default("[]")
  likes        Int      @default(0)
  comments     Int      @default(0)
  favorites    Int      @default(0)
  url          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, category])
}
