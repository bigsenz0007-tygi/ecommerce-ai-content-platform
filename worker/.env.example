WORKER_HEADLESS=1
WORKER_PROFILE_DIR=./.playwright-profile
WORKER_CRON=0 */6 * * *
WORKER_MAX_CANDIDATES_PER_PLATFORM=20
WORKER_SCROLL_ROUNDS=5

WORKER_ENABLE_XHS=1
WORKER_ENABLE_DOUYIN=1

# 发现页 / 详情页可混合配置；建议先放你确认能访问且已登录的平台页面
XHS_DISCOVERY_URLS=https://www.xiaohongshu.com/
DOUYIN_DISCOVERY_URLS=https://www.douyin.com/
XHS_DIRECT_URLS=
DOUYIN_DIRECT_URLS=

TRENDING_INGEST_ENDPOINT=https://your-edgeone-domain/api/trending/ingest
TRENDING_INGEST_TOKEN=

CRAWL_MIN_LIKES=1000
CRAWL_MIN_FAVORITES=50
CRAWL_MIN_COMMENTS=100

# 可复用主站模型配置
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION=1

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION=0

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION=1
