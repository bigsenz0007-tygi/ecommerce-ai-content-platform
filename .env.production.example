# 复制为 .env.production 后填入真实值（勿提交仓库）。
# 腾讯云轻量：DATABASE_URL 指向云数据库，白名单仅放行本机公网出口 IP。

NODE_ENV=production
PORT=3100
# Next standalone 监听地址（勿用 shell 自带的 HOSTNAME）
NEXT_BIND_HOST=0.0.0.0

# 必填：PostgreSQL（sslmode 按云厂商要求）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# 豆包（仅服务端读取；勿使用 NEXT_PUBLIC_ 前缀）
DOUBAO_API_KEY=""
DOUBAO_MODEL=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_VISION=1

# 可选：其他 OpenAI 兼容模型（同上，勿暴露到前端）
# KIMI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 趋势采集 ingest 鉴权（若使用 /api/trending/ingest）
# TRENDING_INGEST_TOKEN=

# 各平台 OAuth 授权页（可公开）
# NEXT_PUBLIC_PLATFORM_OAUTH_XHS=
# NEXT_PUBLIC_PLATFORM_OAUTH_DOUYIN=
