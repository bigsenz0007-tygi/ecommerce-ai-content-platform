{
  "name": "ecommerce-ai-content-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -p 3100",
    "dev:3101": "node ./node_modules/next/dist/bin/next dev -p 3101",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start -p 3100",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "node -e \"try{const fs=require('fs');const p='./node_modules/prisma/build/index.js';if(fs.existsSync(p))require('child_process').execSync('node '+p+' generate',{stdio:'inherit'})}catch(e){console.warn('postinstall prisma generate skipped:',e.message)}\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "next": "15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
