# Postgres（本地与 Vercel 建议同类型；可用 Neon / Supabase 免费库）
# 示例：postgresql://user:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# 开发时 Next 默认 development；生产由 Vercel 注入，也可显式设为 production

# 首页「官方授权登录」跳转（各平台开放平台 OAuth 授权页完整 URL）
NEXT_PUBLIC_PLATFORM_OAUTH_XHS=""
NEXT_PUBLIC_PLATFORM_OAUTH_DOUYIN=""

# 豆包（OpenAI 兼容）
DOUBAO_API_KEY=""
DOUBAO_MODEL=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# 设为 0 可关闭多模态（仅用文本）
# DOUBAO_VISION=1

# Kimi
KIMI_API_KEY=""
KIMI_MODEL=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
# 若模型支持视觉，设为 1
# KIMI_VISION=1

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# ChatGPT / OpenAI 兼容
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
